{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectTemplate",
  "type": "object",
  "required": ["label", "description", "plan"],
  "properties": {
    "$schema": { "type": "string" },
    "label": { "type": "string" },
    "description": { "type": "string" },
    "wizardPages": {
      "type": "array",
      "items": { "$ref": "#/definitions/WizardPage" }
    },
    "lore": { "$ref": "#/definitions/TemplateProjectLore" },
    "plan": { "$ref": "#/definitions/TemplateProjectPlan" }
  },
  "additionalProperties": false,
  "definitions": {
    "WizardPage": {
      "type": "object",
      "required": ["id", "title", "fields"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "fields": { "type": "array", "items": { "$ref": "#/definitions/WizardField" } }
      },
      "additionalProperties": false
    },
    "BaseWizardField": {
      "type": "object",
      "required": ["name", "label", "type"],
      "properties": {
        "name": { "type": "string" },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string" }
      }
    },
    "WizardTextAreaField": {
      "allOf": [{ "$ref": "#/definitions/BaseWizardField" }],
      "properties": {
        "type": { "const": "textarea" },
        "placeholder": { "type": "string" }
      },
      "required": ["type"],
      "unevaluatedProperties": false
    },
    "WizardInputField": {
      "allOf": [{ "$ref": "#/definitions/BaseWizardField" }],
      "properties": {
        "type": { "const": "input" },
        "placeholder": { "type": "string" }
      },
      "required": ["type"],
      "unevaluatedProperties": false
    },
    "WizardSelectAgeRatingField": {
      "allOf": [{ "$ref": "#/definitions/BaseWizardField" }],
      "properties": {
        "type": { "const": "select-age-rating" },
        "defaultValue": {
          "description": "One of the AGE_RATING_ORDER values from shared/ai-engines.ts: G, PG, 12, 16, 18, NC21.",
          "type": "string"
        }
      },
      "required": ["type"],
      "unevaluatedProperties": false
    },
    "WizardIntegerField": {
      "allOf": [{ "$ref": "#/definitions/BaseWizardField" }],
      "properties": {
        "type": { "const": "integer" },
        "min": { "type": "integer" },
        "max": { "type": "integer" },
        "defaultValue": { "type": "integer" }
      },
      "required": ["type", "min", "max"],
      "unevaluatedProperties": false
    },
    "WizardField": {
      "oneOf": [
        { "$ref": "#/definitions/WizardInputField" },
        { "$ref": "#/definitions/WizardTextAreaField" },
        { "$ref": "#/definitions/WizardSelectAgeRatingField" },
        { "$ref": "#/definitions/WizardIntegerField" }
      ]
    },
    "TemplateProjectLore": {
      "type": "object",
      "required": ["nodes"],
      "properties": {
        "nodes": { "type": "array", "items": { "$ref": "#/definitions/TemplateProjectLoreNode" } }
      },
      "additionalProperties": false
    },
    "TemplateProjectLoreNode": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "array", "items": { "type": "string" } },
        "children": { "type": "array", "items": { "$ref": "#/definitions/TemplateProjectLoreNode" } }
      },
      "additionalProperties": false
    },
    "TemplateProjectPlan": {
      "type": "object",
      "required": ["nodes"],
      "properties": {
        "nodes": { "type": "array", "items": { "$ref": "#/definitions/TemplateProjectPlanNode" } }
      },
      "additionalProperties": false
    },
    "TemplateProjectPlanNode": {
      "type": "object",
      "required": ["title", "type"],
      "properties": {
        "title": { "type": "string" },
        "type": { "$ref": "plan-node-types.json#" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "aiUserInstructions": { "type": "array", "items": { "type": "string" } },
        "nodeTypeSettings": { "type": "object" },
        "content": { "type": "array", "items": { "type": "string" } },
        "children": { "type": "array", "items": { "$ref": "#/definitions/TemplateProjectPlanNode" } },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/definitions/TemplateProjectPlanNodeInput" }
        }
      },
      "additionalProperties": false
    },
    "TemplateProjectPlanNodeInput": {
      "type": "object",
      "required": ["sourceNodeTitle", "type"],
      "properties": {
        "sourceNodeTitle": { "type": "string" },
        "type": { "$ref": "plan-edge-types.json#" }
      },
      "additionalProperties": false
    }
  }
}
